# Public URL of this Vercel deployment (no trailing slash).
# Preview: https://<project>-<team>.vercel.app
BETTER_AUTH_URL=https://your-app.vercel.app
BETTER_AUTH_SECRET=

# Postgres (Vercel Postgres / Neon). Unset = embedded PGLite (dev only).
DATABASE_URL=

# Optional federated login
# VITE_AUTH_ENABLED=true
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
